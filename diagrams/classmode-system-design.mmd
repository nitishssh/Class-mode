  ORCH --> LEARN
  ORCH --> RAG
  AIAPI --> ARENA
  COREAPI --> GRADE
  ARENA --> GATEWAY
  GRADE --> GATEWAY
  ARENA --> JOBS

  GATEWAY --> GEMINI
  GATEWAY --> OPENAI
  ORCH --> SEARCH
  ARENA --> SEARCH

  COREAPI --> PG
  COLLAB --> PG
  OPSAPI --> PG
  LEARN --> PG
  RAG --> PG
  WS --> CASS
  JOBS --> REDIS
  ARENA --> REDIS

  AUTH --> GOOG
  OPSAPI --> STRIPE
  OPSAPI --> META
  JOBS --> META
  JOBS --> EXPO
