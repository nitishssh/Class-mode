# ── PersonalLearningPro (EduAI) — Environment Variables ─────────────────────
# Copy to .env and fill in values: cp .env.example .env

NODE_ENV=development
PORT=5001

# ─── Database (Required) ────────────────────────────────────────────────────
# ─── PostgreSQL (Required — replaces MongoDB entirely) ──────────────────────
# Cloud SQL (GCP): postgresql://USER:PASSWORD@localhost/eduai?host=/cloudsql/PROJECT:us-central1:plp-pg
# Local: postgresql://postgres:password@localhost:5432/eduai
POSTGRESQL_URL=

# ─── Firebase Client (Required for auth) ────────────────────────────────────
# Get from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ─── Firebase Admin (Required for server-side token verification) ───────────
# Paste the raw JSON from your service account key file
# Generate: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Auth is the production browser identity provider.
# Set to false only for emergency rollback of the Firebase token exchange route.
ENABLE_FIREBASE_AUTH_COMPAT=true

# Local password auth is a development/compatibility path. Production should leave this unset/false.
ENABLE_LOCAL_PASSWORD_AUTH=false

# ─── Security (Change in production!) ───────────────────────────────────────
# Generate secure values: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
REFRESH_SECRET=

# ─── CORS & URLs ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5001
APP_URL=http://localhost:5001

# ─── DNS ─────────────────────────────────────────────────────────────────────
# Set to "true" if MongoDB Atlas connections fail with ENETUNREACH (IPv6 issues)
DNS_IPV4_FIRST=true

# ─── AI ─────────────────────────────────────────────────────────────────────
# Gemini is the primary AI provider for all features including grading.
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI is an optional fallback for non-grading AI paths.
OPENAI_API_KEY=

# ─── AI Classroom / IniClaw Gateway (Optional) ──────────────────────────────
INICLAW_GATEWAY_URL=http://localhost:7070
BRIDGE_SECRET=
USE_INICLAW=false

# ─── MessagePal (Optional) ──────────────────────────────────────────────────
MESSAGEPAL_PORT=5002

# ─── Email / SMTP (Optional) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduAI <no-reply@yourdomain.com>

# ─── Cassandra / Astra DB (Optional — falls back to MongoDB) ────────────────
ASTRA_DB_SECURE_BUNDLE_PATH=./config/secure-connect-chat-db.zip
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=chat

# ─── Video Calls / Daily.co (Optional) ──────────────────────────────────────
DAILY_API_KEY=

# ─── Billing / Stripe (Optional) ────────────────────────────────────────────
# Billing endpoints return 503 until a real key (sk_live_ or sk_test_) is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_EDUCATOR_ID=
STRIPE_PRICE_INSTITUTION_ID=

# ─── Docker MongoDB (Optional) ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
