# ── PersonalLearningPro (EduAI) — Environment Variables ─────────────────────
# Copy to .env and fill in values: cp .env.example .env

NODE_ENV=development
PORT=5001

# ─── Database (Required) ────────────────────────────────────────────────────
# ─── PostgreSQL (Required — replaces MongoDB entirely) ──────────────────────
# Cloud SQL (GCP): postgresql://USER:PASSWORD@localhost/eduai?host=/cloudsql/PROJECT:us-central1:plp-pg
# Local: postgresql://postgres:password@localhost:5432/eduai
POSTGRESQL_URL=

# ─── Firebase Client (Required for auth) ────────────────────────────────────
# Get from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ─── Firebase Admin (Required for server-side token verification) ───────────
# Paste the raw JSON from your service account key file
# Generate: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Auth is the production browser identity provider.
# Set to false only for emergency rollback of the Firebase token exchange route.
ENABLE_FIREBASE_AUTH_COMPAT=true

# Local password auth is a development/compatibility path. Production should leave this unset/false.
ENABLE_LOCAL_PASSWORD_AUTH=false

# ─── Security (Change in production!) ───────────────────────────────────────
# Generate secure values: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
REFRESH_SECRET=

# ─── CORS & URLs ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5001
APP_URL=http://localhost:5001

# ─── DNS ─────────────────────────────────────────────────────────────────────
# Set to "true" if MongoDB Atlas connections fail with ENETUNREACH (IPv6 issues)
DNS_IPV4_FIRST=true

# ─── AI ─────────────────────────────────────────────────────────────────────
# Gemini is the primary AI provider for all features including grading.
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI is an optional fallback for non-grading AI paths.
OPENAI_API_KEY=

# Anthropic is wired in the AI gateway but NOT mapped to any role by default.
# Only needed if you point a MODEL_REGISTRY alias in server/lib/ai/gateway.ts
# at provider "anthropic" (e.g. orchestrator -> claude-opus-5).
ANTHROPIC_API_KEY=

# ─── Web Search for AI Agents (Optional) ────────────────────────────────────
# The web-search tool (POST /api/ai/web-search) works keyless via DuckDuckGo.
# Provide one of these to upgrade quality. Priority: Tavily > Serper > DuckDuckGo.
TAVILY_API_KEY=
SERPER_API_KEY=

# ─── AI Classroom / IniClaw Gateway (Optional) ──────────────────────────────
INICLAW_GATEWAY_URL=http://localhost:7070
BRIDGE_SECRET=
USE_INICLAW=false

# ─── Google Classroom integration (Optional) ────────────────────────────────
# Create an OAuth 2.0 Web client at:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   http://localhost:5001/api/lms/google/callback   (local dev)
#   https://<your-prod-host>/api/lms/google/callback (production)
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:5001/api/lms/google/callback

# ─── MessagePal (Optional) ──────────────────────────────────────────────────
MESSAGEPAL_PORT=5002

# ─── Email / SMTP (Optional) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduAI <no-reply@yourdomain.com>

# ─── Redis (Optional — cache, BullMQ job queues, domain event bus) ──────────
# Powers: JSON caching (Socratic nudges), Study Arena + SIS-automation job
# queues (BullMQ), and the Redis Streams event bus (durable absence alerts,
# fee events). Unset = all of it degrades gracefully: caching off, job-queue
# features return a clear error, absence alerts fall back to inline sends.
# GCP Memorystore: redis://:AUTH_STRING@INSTANCE_IP:6379
# Local: redis://localhost:6379  (npm run db:up starts one)
REDIS_URL=redis://localhost:6379

# ─── Cassandra / Astra DB (Optional — falls back to MongoDB) ────────────────
ASTRA_DB_SECURE_BUNDLE_PATH=./config/secure-connect-chat-db.zip
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=chat

# ─── Video Calls / Daily.co (Optional) ──────────────────────────────────────
DAILY_API_KEY=

# ─── Billing / Stripe (Optional) ────────────────────────────────────────────
# Billing endpoints return 503 until a real key (sk_live_ or sk_test_) is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_EDUCATOR_ID=
STRIPE_PRICE_INSTITUTION_ID=

# ─── Docker MongoDB (Optional) ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password

# ─── Jules coding agent (Optional) ──────────────────────────────────────────
# API key for scripts/jules.mjs. Create one in the Jules web app:
# https://jules.google → Settings → API (max 3 keys). Keep it secret.
JULES_API_KEY=

# ─── Boot migration (Optional) ──────────────────────────────────────────────
# Set to "true" to apply scripts/pg-schema.sql (idempotent) at server startup,
# under a Postgres advisory lock. The production Docker image enables this so
# deploys never run against a stale schema. Default: off (use `npm run migrate`).
AUTO_MIGRATE=

# ─── WhatsApp Business Cloud API (Optional) ─────────────────────────────────
# Meta WhatsApp Business Cloud API for outbound parent/student messaging and
# the inbound webhook. Without these, sends are simulated (logged) in dev/test.
# Get them from the Meta App dashboard → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional Graph API version (defaults to v21.0).
WHATSAPP_API_VERSION=
# Token you also enter in the Meta dashboard webhook config; must match for the
# GET /api/whatsapp/webhook verification handshake to succeed.
WHATSAPP_VERIFY_TOKEN=
# Master switch for ALL automated WhatsApp messages to parents. Off by
# default: configuring the Meta credentials above is NOT enough to send
# automated messages — set this to "true" as the explicit opt-in. While
# unset/false, no automated message leaves the system: attendance marking
# never dispatches absence alerts, the hourly at-risk nudge scheduler stays
# off, and jobs already queued in Redis are dropped at delivery time.
WHATSAPP_ALERTS_ENABLED=
