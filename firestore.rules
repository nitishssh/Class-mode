rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActive() {
      return request.auth.token.status == 'active';
    }
    
    // Type and length validation helpers
    function isStringWithLimit(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Users can create their own profile document during registration
      allow create: if isOwner(userId)
                    && (!request.resource.data.keys().hasAny(['username']) || isStringWithLimit(request.resource.data.username, 1, 50))
                    && (!request.resource.data.keys().hasAny(['name']) || isStringWithLimit(request.resource.data.name, 1, 100))
                    && (!request.resource.data.keys().hasAny(['email']) || isStringWithLimit(request.resource.data.email, 5, 200))
                    && (!request.resource.data.keys().hasAny(['role']) || (request.resource.data.role is string && request.resource.data.role in ['student', 'teacher', 'parent', 'principal', 'school_admin', 'admin']))
                    && (!request.resource.data.keys().hasAny(['status']) || (request.resource.data.status is string && request.resource.data.status in ['active', 'pending', 'suspended', 'rejected']));
      
      // Prevent privilege escalation and metadata corruption, enforce type safety
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'status', 'email'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) || isStringWithLimit(request.resource.data.username, 1, 50))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isStringWithLimit(request.resource.data.name, 1, 100));
                    
      // Only admins can delete users
      allow delete: if hasRole('admin');
    }

    // Tests collection
    match /tests/{testId} {
      allow read: if isAuthenticated();
      // Active teachers and admins can create/update tests
      allow create, update, delete: if (hasRole('teacher') && isActive()) || hasRole('admin') || hasRole('school_admin') || hasRole('principal');
    }

    // Attempts and answers
    match /testAttempts/{attemptId} {
      // Restrict read access to the student who owns the attempt, teachers, and admins
      allow read: if isAuthenticated() && (isOwner(resource.data.studentUid) || hasRole('teacher') || hasRole('admin') || hasRole('school_admin') || hasRole('principal'));
      
      // Students can create their own attempt
      allow create: if hasRole('student') && isActive() && isOwner(request.resource.data.studentUid)
                    && (!request.resource.data.keys().hasAny(['score']) || request.resource.data.score == null)
                    && (!request.resource.data.keys().hasAny(['testId']) || request.resource.data.testId is number)
                    && (!request.resource.data.keys().hasAny(['status']) || (request.resource.data.status is string && request.resource.data.status in ['in_progress', 'completed', 'evaluated']));
      
      // Prevent students from updating sensitive fields like score or re-assigning the attempt
      allow update: if (hasRole('student') && isActive() && isOwner(resource.data.studentUid)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'studentUid', 'testId'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || (request.resource.data.status is string && request.resource.data.status in ['in_progress', 'completed', 'evaluated']))
                    )
                    || hasRole('teacher') || hasRole('admin') || hasRole('school_admin') || hasRole('principal');
    }
  }
}
